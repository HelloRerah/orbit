generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  STAFF
}

model User {
  id                   String               @id @default(uuid()) @db.Uuid
  email                String               @unique
  passwordHash         String
  firstName            String
  lastName             String
  phone                String?
  role                 Role                 @default(CUSTOMER)
  isActive             Boolean              @default(true)
  createdAt            DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @db.Timestamptz(3)
  orders               Order[]
  orderStatusHistories OrderStatusHistory[]
  payments             Payment[]

  @@map("users")
}

enum ProductType {
  RENTAL
  LICENSE
}

model Product {
  id             String      @id @default(uuid()) @db.Uuid
  halabServiceId String      @unique
  name           String
  brand          String?
  description    String?
  type           ProductType
  costUsd        Decimal     @db.Decimal(12, 4)
  isVisible      Boolean     @default(false)
  isActive       Boolean     @default(true)
  lastSyncedAt   DateTime?   @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)
  orders         Order[]

  @@map("products")
}

model Setting {
  id                     Int      @id @default(1)
  exchangeRateUsdZar     Decimal  @db.Decimal(10, 4)
  markupPercent          Decimal  @db.Decimal(5, 2)
  priceRoundingZar       Decimal  @default(1) @db.Decimal(10, 2)
  lowBalanceThresholdUsd Decimal  @db.Decimal(12, 2)
  updatedAt              DateTime @updatedAt @db.Timestamptz(3)

  @@map("settings")
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  SUBMITTED
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

model Order {
  id                   String               @id @default(uuid()) @db.Uuid
  userId               String               @db.Uuid
  user                 User                 @relation(fields: [userId], references: [id])
  productId            String               @db.Uuid
  product              Product              @relation(fields: [productId], references: [id])
  type                 ProductType
  sessionHours         Int?                 @db.SmallInt
  status               OrderStatus          @default(PENDING_PAYMENT)
  productNameSnapshot  String
  priceZar             Decimal              @db.Decimal(10, 2)
  costUsd              Decimal              @db.Decimal(12, 4)
  exchangeRateUsdZar   Decimal              @db.Decimal(10, 4)
  markupPercent        Decimal              @db.Decimal(5, 2)
  vatRate              Decimal?             @db.Decimal(5, 2)
  vatAmountZar         Decimal?             @db.Decimal(10, 2)
  deviceInfo           Json?
  createdAt            DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @db.Timestamptz(3)
  orderStatusHistories OrderStatusHistory[]
  rental               Rental?
  license              License?
  payments             Payment[]

  @@index([userId, createdAt])
  @@index([status])
  @@map("orders")
}

enum ActorType {
  SYSTEM
  CUSTOMER
  STAFF
}

model OrderStatusHistory {
  id          String       @id @default(uuid()) @db.Uuid
  orderId     String       @db.Uuid
  order       Order        @relation(fields: [orderId], references: [id])
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  actorType   ActorType
  actorUserId String?      @db.Uuid
  actorUser   User?        @relation(fields: [actorUserId], references: [id])
  note        String?
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model Rental {
  id                   String   @id @default(uuid()) @db.Uuid
  orderId              String   @unique @db.Uuid
  order                Order    @relation(fields: [orderId], references: [id])
  credentialsEncrypted String
  startsAt             DateTime @db.Timestamptz(3)
  endsAt               DateTime @db.Timestamptz(3)
  createdAt            DateTime @default(now()) @db.Timestamptz(3)

  @@index([endsAt])
  @@map("rentals")
}

model License {
  id                  String    @id @default(uuid()) @db.Uuid
  orderId             String    @unique @db.Uuid
  order               Order     @relation(fields: [orderId], references: [id])
  licenseKeyEncrypted String
  issuedAt            DateTime  @db.Timestamptz(3)
  expiresAt           DateTime? @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)

  @@map("licenses")
}

enum PaymentProvider {
  MOCK
  PAYFAST
  YOCO
  OZOW
  PEACH
}

enum PaymentPurpose {
  ORDER
  TOPUP
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

model Payment {
  id                String          @id @default(uuid()) @db.Uuid
  userId            String          @db.Uuid
  user              User            @relation(fields: [userId], references: [id])
  purpose           PaymentPurpose
  orderId           String?         @db.Uuid
  order             Order?          @relation(fields: [orderId], references: [id])
  provider          PaymentProvider
  providerReference String?
  amountZar         Decimal         @db.Decimal(10, 2)
  status            PaymentStatus   @default(PENDING)
  rawWebhook        Json?
  paidAt            DateTime?       @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)

  @@unique([provider, providerReference])
  @@index([orderId])
  @@index([userId, createdAt])
  @@map("payments")
}
