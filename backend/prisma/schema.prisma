generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  STAFF
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String 
  firstName    String
  lastName     String
  phone        String? 
  role         Role     @default(CUSTOMER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@map("users")
}

enum ProductType {
  RENTAL
  LICENSE
}

model Product {
  id             String      @id @default(uuid()) @db.Uuid
  halabServiceId String      @unique
  name           String
  brand          String?
  description    String?
  type           ProductType
  costUsd        Decimal     @db.Decimal(12, 4)
  isVisible      Boolean     @default(false)
  isActive       Boolean     @default(true)
  lastSyncedAt   DateTime?   @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)

  @@map("products")
}

model Setting {
  id                     Int      @id @default(1)
  exchangeRateUsdZar     Decimal  @db.Decimal(10, 4)
  markupPercent          Decimal  @db.Decimal(5, 2)
  priceRoundingZar       Decimal  @default(1) @db.Decimal(10, 2)
  lowBalanceThresholdUsd Decimal  @db.Decimal(12, 2)
  updatedAt              DateTime @updatedAt @db.Timestamptz(3)

  @@map("settings")
}